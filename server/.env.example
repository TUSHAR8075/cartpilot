# --- PayPal (Sandbox) : https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
# Optional: webhook ID from your sandbox app (enables signature verification)
PAYPAL_WEBHOOK_ID=

# --- AI (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Product search (optional). Without it, the built-in demo catalog is used.
CHANNEL3_API_KEY=

# --- MongoDB (recommended). Stores sessions, carts, Autopilot rules/watches/activity and orders.
# Without it: orders in memory, sessions in server/.data/sessions.json
MONGODB_URI=mongodb://127.0.0.1:27017/cartpilot

# Demo helper: lets the Autopilot panel simulate a price drop (set false in production)
DEMO_PRICE_SIMULATION=true

PORT=8080
